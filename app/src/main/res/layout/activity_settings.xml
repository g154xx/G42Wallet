<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Setări EMV"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/et_pan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="PAN (e.g., 1234567890123456)"
            android:inputType="number" />

        <EditText
            android:id="@+id/et_expiry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Expiry (YYMM)"
            android:inputType="number" />

        <EditText
            android:id="@+id/et_service_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Service Code (e.g., 101)"
            android:inputType="number" />

        <EditText
            android:id="@+id/et_country"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Country Code (hex, e.g., 0840)"
            android:inputType="text" />

        <EditText
            android:id="@+id/et_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Amount (hex, 12 digits, e.g., 000000000500 for 5.00)"
            android:inputType="text" />

        <EditText
            android:id="@+id/et_aid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="AID (hex, e.g., A0000000041010)"
            android:inputType="text" />

        <EditText
            android:id="@+id/et_key_hex"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="EMV Key (hex, 16/24/32 bytes)"
            android:inputType="text" />

        <Button
            android:id="@+id/btn_save_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Salvează"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>