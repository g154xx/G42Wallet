<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#f5f5f5">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#1a237e"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- Buton Start/Stop HCE -->
    <Button
        android:id="@+id/btn_start_hce"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/menu_start_hce"
        android:backgroundTint="#4CAF50"
        android:textColor="#ffffff"
        android:textSize="18sp"
        android:padding="16dp"
        android:layout_marginBottom="8dp" />

    <!-- Celelalte butoane aranjate în perechi, pe două coloane -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btn_diagnostic"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/menu_diagnostic"
            android:textSize="16sp"
            android:padding="12dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_card_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/menu_card_info"
            android:textSize="16sp"
            android:padding="12dp"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btn_load_keys"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/menu_load_keys"
            android:textSize="16sp"
            android:padding="12dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_generate_track"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/menu_generate_track"
            android:textSize="16sp"
            android:padding="12dp"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btn_settings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/menu_settings"
            android:textSize="16sp"
            android:padding="12dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_network"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/menu_network"
            android:textSize="16sp"
            android:padding="12dp"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btn_about"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/menu_about"
            android:textSize="16sp"
            android:padding="12dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_health_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/menu_health_card"
            android:textSize="16sp"
            android:padding="12dp"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_id_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/menu_id_card"
        android:textSize="16sp"
        android:padding="12dp"
        android:layout_marginBottom="16dp" />

    <!-- Status -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/status_ready"
        android:textSize="15sp"
        android:padding="10dp"
        android:background="#e8eaf6"
        android:textColor="#1a237e"
        android:layout_marginBottom="12dp" />

    <!-- Log -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#ffffff"
        android:padding="8dp"
        android:elevation="2dp">

        <TextView
            android:id="@+id/tv_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[Log]\n"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textColor="#333333" />
    </ScrollView>

</LinearLayout>