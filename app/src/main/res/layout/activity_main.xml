<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#f5f5f5">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="G4² Wallet"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#1a237e"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_start_hce"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start HCE"
        android:backgroundTint="#4CAF50"
        android:textColor="#ffffff"
        android:textSize="18sp"
        android:padding="16dp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">
        <Button
            android:id="@+id/btn_diagnostic"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Diagnostic"
            android:textSize="16sp"
            android:padding="12dp"
            android:layout_marginEnd="4dp" />
        <Button
            android:id="@+id/btn_card_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Card Info"
            android:textSize="16sp"
            android:padding="12dp"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">
        <Button
            android:id="@+id/btn_load_keys"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Load Keys"
            android:textSize="16sp"
            android:padding="12dp"
            android:layout_marginEnd="4dp" />
        <Button
            android:id="@+id/btn_generate_track"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Generate Track2"
            android:textSize="16sp"
            android:padding="12dp"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">
        <Button
            android:id="@+id/btn_settings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Settings"
            android:textSize="16sp"
            android:padding="12dp"
            android:layout_marginEnd="4dp" />
        <Button
            android:id="@+id/btn_network"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Network"
            android:textSize="16sp"
            android:padding="12dp"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">
        <Button
            android:id="@+id/btn_about"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="About"
            android:textSize="16sp"
            android:padding="12dp"
            android:layout_marginEnd="4dp" />
        <Button
            android:id="@+id/btn_health_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Health Card"
            android:textSize="16sp"
            android:padding="12dp"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_id_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ID Card"
        android:textSize="16sp"
        android:padding="12dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status: Ready"
        android:textSize="15sp"
        android:padding="10dp"
        android:background="#e8eaf6"
        android:textColor="#1a237e"
        android:layout_marginBottom="12dp" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#ffffff"
        android:padding="8dp"
        android:elevation="2dp">
        <TextView
            android:id="@+id/tv_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[Log]\n"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textColor="#333333" />
    </ScrollView>

</LinearLayout>